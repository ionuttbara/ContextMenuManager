# ==============================================================================
# Visual Studio & .NET / C# .gitignore
# ==============================================================================

# Folderele de compilare (Aici se generează .exe-ul, .dll-urile și fișierele temporare)
[Bb]in/
[Oo]bj/

# Fisiere de configurare locale specifice utilizatorului (Visual Studio)
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Binare și fișiere de debugging (pentru a nu urca fișiere inutile în Git)
*.dll
*.exe
*.pdb
*.cache
*.resources
*.ilk
*.lib
*.sbr

# Fisiere temporare și de log
*.log
*.tmp
*.bak
*.swp
*~.nib
local.properties

# Extensii Visual Studio (ReSharper / Rider)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Cache-uri de pachete (dacă folosești NuGet pe viitor)
packages/
*.nupkg

# Alte fișiere generate la nivel de OS
Thumbs.db
ehthumbs.db
.DS_Store